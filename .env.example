# Copy to .env, or run: bash scripts/init_env.sh (it also generates the secrets).
# Keep passwords alphanumeric, they are embedded in connection URIs.

# Airflow
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me
AIRFLOW_FERNET_KEY=

# PostgreSQL (Airflow metadata only)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# MongoDB (pipeline data)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=pipeline_db
MONGO_APP_USER=pipeline_app
MONGO_APP_PASSWORD=change-me

# Banxico SIE token (free): https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Days of history each run fetches
PIPELINE_LOOKBACK_DAYS=7
